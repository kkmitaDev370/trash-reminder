{
  "name": "trash-reminder",
  "version": "1.0.35",
  "main": "index.js",
  "scripts": {
    "start": "cross-env EXPO_NO_BROWSER=1 BROWSER=none expo start --web",
    "dev": "node scripts/bump-build-version.mjs && eas build --platform android --profile development",
    "prod": "node scripts/bump-build-version.mjs && eas build --platform android --profile production && eas update --channel production --non-interactive"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "expo": "~54.0.33",
    "expo-auth-session": "~6.2.0",
    "expo-dev-client": "~6.0.20",
    "expo-dev-menu": "7.0.18",
    "expo-document-picker": "^13.1.0",
    "expo-file-system": "^18.1.10",
    "expo-image-picker": "~16.1.1",
    "expo-notifications": "~0.32.16",
    "expo-status-bar": "~3.0.9",
    "expo-updates": "~29.0.16",
    "expo-web-browser": "~14.2.0",
    "firebase": "^12.1.0",
    "lodash": "^4.17.23",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-calendars": "^1.1314.0",
    "react-native-web": "^0.21.0"
  },
  "private": true,
  "devDependencies": {
    "@types/react": "~19.1.10",
    "@types/react-native": "^0.72.8",
    "babel-preset-expo": "^54.0.10",
    "cross-env": "^10.1.0",
    "typescript": "~5.9.2"
  }
}
